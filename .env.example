# AionHive Environment Configuration
# Copy this file to .env and update values for your environment

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL=postgres://postgres:password@localhost:5432/aionhive

# =============================================================================
# HTTP SERVER (MCP Transport: streamable-http + SSE)
# =============================================================================
# Transport mode: "http" (REST + SSE) or "stdio" (stdin/stdout)
AION_HIVE_TRANSPORT=http
# Port for HTTP server
AION_HIVE_HTTP_PORT=8080

# =============================================================================
# DIRECTORIES
# =============================================================================
AION_HIVE_DATA_DIR=./data
AION_HIVE_SKILLS_DIR=./data/skills

# =============================================================================
# SECURITY - IMPORTANT: Change this in production!
# =============================================================================
AION_HIVE_JWT_SECRET=change_this_secret_in_production
# JWT expiry in hours (default: 24)
AION_HIVE_JWT_EXPIRY_HOURS=24
# MCP stdio transport JWT token (optional; required for MCP auth in stdio mode)
# AION_HIVE_JWT_TOKEN=

# =============================================================================
# SKILL DOWNLOAD (tar.gz packaging + signed URLs)
# =============================================================================
# Public-facing base URL for skill download links (no trailing slash).
# Falls back to http://localhost:{AION_HIVE_HTTP_PORT} if not set.
AION_HIVE_PUBLIC_URL=http://localhost:8080
# HMAC secret for signing download tokens. Falls back to AION_HIVE_JWT_SECRET,
# then to a built-in default. Must match between server and download verifier.
# AION_HIVE_DOWNLOAD_SECRET=

# =============================================================================
# EVALUATION WEBHOOKS (comma-separated for multiple URLs)
# =============================================================================
AION_HIVE_EVAL_WEBHOOK_URLS=

# =============================================================================
# GITLAB INTEGRATION (skill version management + push)
# =============================================================================
# GitLab instance URL
GITLAB_URL=https://gitlab.com
# GitLab group path for skill repositories
GITLAB_GROUP=skill-garden
# GitLab personal access token (api + read_repository + write_repository scopes)
GITLAB_TOKEN=
# Enable automatic push to GitLab on skill upload (true or false)
GITLAB_PUSH_ENABLED=false
# Webhook secret for verifying GitLab webhook requests (X-Gitlab-Token header)
GITLAB_WEBHOOK_SECRET=skill-garden-webhook

# =============================================================================
# DOCKER SANDBOX
# =============================================================================
# Docker daemon TCP endpoint for sandbox execution
# DOCKER_HOST=http://localhost:2375

# =============================================================================
# GIT PROXY
# =============================================================================
# Git proxy API base URL
# GIT_PROXY_API_BASE=http://localhost:8081