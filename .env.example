# AionHive Environment Configuration
# Copy this file to .env and update values for your environment

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL=postgres://postgres:password@localhost:5432/aionhive

# =============================================================================
# HTTP SERVER (MCP Transport: streamable-http + SSE)
# =============================================================================
# Transport mode: "http" (REST + SSE) or "stdio" (stdin/stdout)
AION_HIVE_TRANSPORT=http
# Port for HTTP server
AION_HIVE_HTTP_PORT=8080

# =============================================================================
# DIRECTORIES
# =============================================================================
AION_HIVE_DATA_DIR=./data

# =============================================================================
# SECURITY - IMPORTANT: Change this in production!
# =============================================================================
AION_HIVE_JWT_SECRET=change_this_secret_in_production
# JWT expiry in hours (default: 24)
AION_HIVE_JWT_EXPIRY_HOURS=24
# MCP stdio transport JWT token (optional; required for MCP auth in stdio mode)
# AION_HIVE_JWT_TOKEN=
# CLI token encryption key (32 bytes hex = 64 hex chars, for encrypting API key in config.toml)
# Generate with: openssl rand -hex 32
# If not set, API key will be written in plain text to config.toml
AION_HIVE_CLI_ENCRYPTION_KEY=a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2

# =============================================================================
# SKILL DOWNLOAD (tar.gz packaging + signed URLs)
# =============================================================================
# Public-facing base URL for skill download links (no trailing slash).
# Falls back to http://localhost:{AION_HIVE_HTTP_PORT} if not set.
AION_HIVE_PUBLIC_URL=http://localhost:8080
# HMAC secret for signing download tokens. Falls back to AION_HIVE_JWT_SECRET,
# then to a built-in default. Must match between server and download verifier.
# AION_HIVE_DOWNLOAD_SECRET=

# =============================================================================
# EVALUATION WEBHOOKS (comma-separated for multiple URLs)
# =============================================================================
AION_HIVE_EVAL_WEBHOOK_URLS=

# =============================================================================
# GITLAB INTEGRATION (skill version management + push)
# =============================================================================
# GitLab instance URL
GITLAB_URL=https://gitlab.com
# GitLab group path for skill repositories
GITLAB_GROUP=skill-garden
# GitLab personal access token (api + read_repository + write_repository scopes)
GITLAB_TOKEN=
# Enable automatic push to GitLab on skill upload (true or false)
GITLAB_PUSH_ENABLED=false
# Webhook secret for verifying GitLab webhook requests (X-Gitlab-Token header)
GITLAB_WEBHOOK_SECRET=skill-garden-webhook

# =============================================================================
# DOCKER SANDBOX
# =============================================================================
# Docker daemon TCP endpoint for sandbox execution
# DOCKER_HOST=http://localhost:2375

# =============================================================================
# GIT PROXY
# =============================================================================
# Git proxy API base URL
# GIT_PROXY_API_BASE=http://localhost:8081

# =============================================================================
# TENANT MODE (Multi-tenancy)
# =============================================================================
# Operating mode: saas | private_enterprise | internal_delivery
AION_HIVE_TENANT_MODE=saas
#
# Mode comparison:
# +-------------------+------------------------+------------------------+
# | Feature           | saas                   | private_enterprise /    |
# |                   |                        | internal_delivery       |
# +-------------------+------------------------+------------------------+
# | User registration | Auto-create tenant     | Admin creates tenant    |
# | Admin assignment  | User becomes admin     | Admin specifies admin   |
# | Self-service      | Optional (see below)   | Disabled               |
# +-------------------+------------------------+------------------------+

# -----------------------------------------------------------------------------
# SaaS Mode Options (effective when AION_HIVE_TENANT_MODE=saas)
# -----------------------------------------------------------------------------

# Allow users to create tenants via application (not auto on registration)
# - true: Users can apply to create tenants (with optional approval)
# - false: Tenants only created automatically on registration
AION_HIVE_SELF_SERVICE_TENANT=true

# Maximum number of tenants a single user can create (0 = unlimited)
# Applies only when SELF_SERVICE_TENANT is true
AION_HIVE_MAX_TENANTS_PER_USER=1

# Require admin approval for self-service tenant creation
# - true: User applies -> Admin approves -> Tenant created
# - false: Tenant created immediately on application
AION_HIVE_TENANT_APPROVAL_REQUIRED=false

# -----------------------------------------------------------------------------
# Enterprise Mode Options (effective when mode is private_enterprise or
# internal_delivery)
# -----------------------------------------------------------------------------

# Path to license file for quota management
# Format: {"max_tenants": 5, "features": ["sso", "audit"]}
# Leave empty to disable quota enforcement
AION_HIVE_LICENSE_FILE=

# Example license.json content:
# {
#   "max_tenants": 5,
#   "features": ["sso", "audit"]
# }