# Production 环境配置
# ===========================================
# ⚠️  警告: 此文件包含敏感配置，请勿提交到代码仓库
# ⚠️  生产环境请使用 Vault / Sealed Secrets / CI Secret 管理

IMAGE_TAG=v0.3.0

# 数据库连接 (Secret) - 必须设置
DATABASE_URL=postgres://prod-db:5432/aionhive

# JWT 密钥 (Secret) - 必须设置，最少 32 字符
# 建议: openssl rand -base64 48 | tr -d '\n'
JWT_SECRET=

# API Key 盐值 (Secret) - 必须设置
API_KEY_SALT=

# 运行配置 (非敏感)
AION_HIVE_TRANSPORT=http
AION_HIVE_HTTP_PORT=8080
AION_HIVE_DATA_DIR=/data
AION_HIVE_SKILLS_DIR=/skills
RUST_LOG=warn
REPLICAS=5
