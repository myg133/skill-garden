# Staging 环境配置
# ===========================================

IMAGE_TAG=develop-latest

# 数据库连接 (Secret)
# CI/CD 流水线应通过 CI_SECRET 管理，这里仅作占位
DATABASE_URL=postgres://staging-db:5432/aionhive

# JWT 密钥 (Secret) - 必须设置，最少 32 字符
# 建议使用: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_IN_STAGING_MIN_32_CHARS

# API Key 盐值 (Secret) - 必须设置
API_KEY_SALT=CHANGE_ME_IN_STAGING_SALT

# 运行配置 (非敏感)
AION_HIVE_TRANSPORT=http
AION_HIVE_HTTP_PORT=8080
AION_HIVE_DATA_DIR=/data
AION_HIVE_SKILLS_DIR=/skills
RUST_LOG=info
REPLICAS=2
